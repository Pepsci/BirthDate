{
  "expo": {
    "name": "BirthReminder",
    "slug": "birthreminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birthreminder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.birthreminder.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BirthReminder peut utiliser la caméra pour scanner une carte bancaire lors d'une participation à une cagnotte."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.birthreminder.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0b1120",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3b82f6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BirthReminder accède à tes photos uniquement pour choisir ta photo de profil.",
          "cameraPermission": "BirthReminder peut utiliser la caméra pour scanner une carte bancaire lors d'une participation à une cagnotte.",
          "microphonePermission": false
        }
      ],
      "./plugins/withAppGroupEntitlement",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "8UHXMY6BW5"
        }
      ],
      "./plugins/withNsePod"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c941838-86ec-422a-96dd-42982be00557",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "BirthReminderNSE",
                  "bundleIdentifier": "com.birthreminder.app.BirthReminderNSE",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.birthreminder.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
