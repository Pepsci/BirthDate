# ─── Configuration serveur BirthReminder ─────────────────────────────────────
# Copier ce fichier en `.env` puis remplir les valeurs :  cp .env.example .env

# Le front (apiHandler.jsx) attend le back sur le port 4000 en local.
PORT=4000
NODE_ENV=development

# Base de données — chaîne MongoDB Atlas (aucun Mongo local requis)
MONGO_URI=

# Secrets auth (n'importe quelle chaîne longue et aléatoire en local)
TOKEN_SECRET=dev_token_secret_change_me
SESSION_SECRET=dev_session_secret_change_me

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ─── Avatars (nouveau stockage disque) ───────────────────────────────────────
# En local, laisser vide = server/uploads/avatars (créé automatiquement).
# En prod EC2 : AVATAR_DIR=/var/www/birthreminder/uploads/avatars
AVATAR_DIR=

# ─── Photos de carte (dates manuelles, même principe que les avatars) ────────
# En local, laisser vide = server/uploads/card-photos (créé automatiquement).
# En prod EC2 : CARD_PHOTO_DIR=/var/www/birthreminder/uploads/card-photos
CARD_PHOTO_DIR=

# ─── Optionnels en local (non requis pour tester les avatars) ────────────────
# Cloudinary — plus utilisé pour les avatars, gardé le temps de la transition
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# AWS SES (emails) — le serveur démarre sans, les envois d'email échoueront
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
EMAIL_FROM=
EMAIL_BRTHDAY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=

# Stripe (cagnotte) — le serveur démarre sans (simple warning)
STRIPE_SECRET_KEY=

# Stats API interne
STATS_API_KEY=
